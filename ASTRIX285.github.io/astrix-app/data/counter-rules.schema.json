{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/schemas/counter-rules.schema.json",
  "title": "ASTRIX PARADOX Counter Rules (Anti-Champion 2.0 / Surge / Shield / Bane)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "scope",
    "sandbox",
    "seedStatus",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "const": "Armor 3.0"
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "updateVersion",
        "liveSince",
        "frozen"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "updateVersion": {
          "type": "string",
          "minLength": 1
        },
        "liveSince": {
          "type": "string",
          "format": "date"
        },
        "frozen": {
          "type": "boolean"
        }
      }
    },
    "seedStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "championFrameTableAvailable",
        "championVerbTableVerified",
        "notes"
      ],
      "properties": {
        "championFrameTableAvailable": {
          "type": "boolean"
        },
        "championVerbTableVerified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "date"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value",
        "strength",
        "verified"
      ],
      "properties": {
        "method": {
          "enum": [
            "weaponFrame",
            "subclassVerb",
            "exoticIntrinsic",
            "element",
            "damageBuff"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "enum": [
            "primary",
            "secondary",
            "situational"
          ]
        },
        "componentRef": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "note": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "threat",
        "subject",
        "counters",
        "reasoning",
        "verified",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "threat": {
          "enum": [
            "champion",
            "surge",
            "shield",
            "bane"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "counters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/counter"
          }
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "threat": {
                "const": "champion"
              }
            },
            "required": [
              "threat"
            ]
          },
          "then": {
            "properties": {
              "subject": {
                "enum": [
                  "Barrier",
                  "Overload",
                  "Unstoppable"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "threat": {
                "enum": [
                  "surge",
                  "shield"
                ]
              }
            },
            "required": [
              "threat"
            ]
          },
          "then": {
            "properties": {
              "subject": {
                "enum": [
                  "Arc",
                  "Solar",
                  "Void",
                  "Stasis",
                  "Strand"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
