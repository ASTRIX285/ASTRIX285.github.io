{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/schemas/armor-3-components.schema.json",
  "title": "ASTRIX PARADOX Armor 3.0 Component Library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "scope",
    "seedStatus",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "const": "Armor 3.0"
    },
    "seedStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setBonusTableAvailable",
        "notes"
      ],
      "properties": {
        "setBonusTableAvailable": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "date"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "statModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stat",
        "value"
      ],
      "properties": {
        "stat": {
          "enum": [
            "Weapons",
            "Health",
            "Class",
            "Grenade",
            "Super",
            "Melee"
          ]
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "bonusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "effect",
        "verified"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "setBonusEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "twoPiece",
        "fourPiece"
      ],
      "properties": {
        "twoPiece": {
          "$ref": "#/$defs/bonusEntry"
        },
        "fourPiece": {
          "$ref": "#/$defs/bonusEntry"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "subclass",
        "element",
        "effect",
        "verified",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "fragment",
            "aspect",
            "setBonus",
            "artifactPerk"
          ]
        },
        "subclass": {
          "type": [
            "string",
            "null"
          ]
        },
        "element": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "Hunter",
            "Titan",
            "Warlock"
          ]
        },
        "effect": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "statModifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statModifier"
          }
        },
        "fragmentSlots": {
          "type": "integer",
          "minimum": 0
        },
        "artifactName": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "setBonus": {
          "$ref": "#/$defs/setBonusEntries"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fragment"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "statModifiers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/statModifier"
                }
              }
            },
            "required": [
              "statModifiers"
            ]
          },
          "else": {
            "properties": {
              "statModifiers": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aspect"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "fragmentSlots": {
                "type": "integer",
                "minimum": 0
              },
              "class": {
                "type": "string",
                "enum": [
                  "Hunter",
                  "Titan",
                  "Warlock"
                ]
              }
            },
            "required": [
              "fragmentSlots",
              "class"
            ]
          },
          "else": {
            "properties": {
              "fragmentSlots": false,
              "class": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "artifactPerk"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "artifactName": {
                "type": "string",
                "minLength": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "artifactName",
              "column"
            ]
          },
          "else": {
            "properties": {
              "artifactName": false,
              "column": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "setBonus"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "setBonus": {
                "$ref": "#/$defs/setBonusEntries"
              }
            },
            "required": [
              "setBonus"
            ]
          },
          "else": {
            "properties": {
              "setBonus": false
            }
          }
        }
      ]
    }
  }
}
